def chatbot(text):
    text = text.lower()
    if "hello" in text or "hi" in text:
        return "Hello! How can I help you?"
    elif "how are you" in text:
        return "I'm just a program, but I'm doing great!"
    elif "bye" in text:
        return "Goodbye! Have a nice day."
    else:
        return "I don't understand that yet."

while True:
    user_input = input("You: ")
    if user_input.lower() == "exit":
        break
    print("Bot:", chatbot(user_input))
    
2. Single Neuron / Perceptron (No Libraries)

def sigmoid(x):
    return 1 / (1 + 2.71828 ** (-x))

def train_perceptron():
    weight = 0.5
    bias = 0.0
    lr = 0.1
    # Training data: input -> expected output
    data = [(1, 1), (0, 0), (2, 1), (-1, 0)]

    for epoch in range(1000):
        for x, target in data:
            output = sigmoid(weight * x + bias)
            error = target - output
            weight += lr * error * x
            bias += lr * error

    return weight, bias

w, b = train_perceptron()
print("Trained weight:", w, "bias:", b)

test_input = 1.5
result = sigmoid(w * test_input + b)
print("Prediction for 1.5:", result)

3. Tic-Tac-Toe with Minimax AI

def print_board(b):
    for row in [b[0:3], b[3:6], b[6:9]]:
        print(row)

def check_winner(b, player):
    wins = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
    return any(all(b[i] == player for i in combo) for combo in wins)

def minimax(b, is_max):
    if check_winner(b, "X"): return 1
    if check_winner(b, "O"): return -1
    if " " not in b: return 0

    scores = []
    for i in range(9):
        if b[i] == " ":
            b[i] = "X" if is_max else "O"
            scores.append(minimax(b, not is_max))
            b[i] = " "
    return max(scores) if is_max else min(scores)

def best_move(b):
    best_score = -float("inf")
    move = None
    for i in range(9):
        if b[i] == " ":
            b[i] = "X"
            score = minimax(b, False)
            b[i] = " "
            if score > best_score:
                best_score = score
                move = i
    return move

board = [" "]*9
board[4] = "O"  # opponent's move
move = best_move(board)
print("AI chooses position:", move)

