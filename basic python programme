5. Basic Search Algorithm (BFS Pathfinding — used in AI agents)
python
from collections import deque

graph = {
    'A': ['B', 'C'],
    'B': ['D'],
    'C': ['D'],
    'D': ['E'],
    'E': []
}

def bfs(start, goal):
    queue = deque([[start]])
    visited = set()

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node == goal:
            return path

        if node not in visited:
            visited.add(node)
            for neighbor in graph.get(node, []):
                new_path = list(path)
                new_path.append(neighbor)
                queue.append(new_path)

    return None

result = bfs('A', 'E')
print("Path found:", result)

6. Simple Genetic Algorithm (Guess a Target Number)
python
import random

target = 42
population = [random.randint(0, 100) for _ in range(10)]

def fitness(x):
    return -abs(target - x)

for generation in range(50):
    population.sort(key=fitness, reverse=True)
    if population[0] == target:
        break

    # Keep top 2, mutate to create new ones
    survivors = population[:2]
    new_population = survivors.copy()
    while len(new_population) < 10:
        parent = random.choice(survivors)
        child = parent + random.randint(-5, 5)
        new_population.append(child)

    population = new_population

print("Best guess after evolution:", population[0])
print("Generations run:", generation + 1)
