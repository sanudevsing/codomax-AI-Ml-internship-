2. Calculate Average (like averaging model scores)
python
def calculate_average(scores):
    total = 0
    for score in scores:
        total = total + score
    average = total / len(scores)
    return average

accuracy_scores = [85, 90, 78, 92, 88]
result = calculate_average(accuracy_scores)
print("Average accuracy:", result)
3. Find Maximum Value (like finding best prediction score)
python
def find_max(values):
    max_value = values[0]
    for v in values:
        if v > max_value:
            max_value = v
    return max_value

predictions = [0.72, 0.91, 0.65, 0.88, 0.95]
print("Best prediction score:", find_max(predictions))
4. Count Labels (like counting classes in a dataset)

def count_label(labels, target_label):
    count = 0
    for label in labels:
        if label == target_label:
            count = count + 1
    return count

dataset_labels = ["cat", "dog", "cat", "cat", "dog", "bird"]
cat_count = count_label(dataset_labels, "cat")
print("Number of 'cat' labels:", cat_count)
5. Simulate a Simple Weight Update Loop

def train_weight():
    weight = 0.0
    learning_rate = 0.1
    target = 5

    for step in range(10):
        error = target - weight
        weight = weight + learning_rate * error
        print(f"Step {step+1}: weight = {weight:.2f}")

    return weight

final_weight = train_weight()
print("Final trained weight:", final_weight)
6. Normalize a List (common AI preprocessing step)

def normalize(values):
    max_val = max(values)
    min_val = min(values)
    normalized = []
    for v in values:
        norm_value = (v - min_val) / (max_val - min_val)
        normalized.append(norm_value)
    return normalized

raw_data = [10, 20, 30, 40, 50]
print("Normalized data:", normalize(raw_data))
