def classify(temperature):
    if temperature > 30:
        return "Hot"
    elif temperature > 15:
        return "Warm"
    else:
        return "Cold"

temperatures = [35, 10, 22, 5, 28]
for temp in temperatures:
    result = classify(temp)
    print(f"{temp}°C is classified as {result}")
8. Sum of Squared Errors (used in loss calculation)

def squared_error_sum(actual, predicted):
    total_error = 0
    for i in range(len(actual)):
        error = (actual[i] - predicted[i]) ** 2
        total_error = total_error + error
    return total_error

actual_values = [3, 5, 2, 8]
predicted_values = [2.5, 5.5, 2, 7]
error = squared_error_sum(actual_values, predicted_values)
print("Total squared error:", error)
9. Build a Vocabulary List (like NLP tokenization)

def build_vocabulary(sentence):
    words = sentence.split()
    vocabulary = []
    for word in words:
        if word not in vocabulary:
            vocabulary.append(word)
    return vocabulary

text = "the cat sat on the mat the cat ran"
vocab = build_vocabulary(text)
print("Vocabulary:", vocab)
10. Simple Voting System (like ensemble learning)

def majority_vote(predictions):
    votes = {}
    for pred in predictions:
        if pred in votes:
            votes[pred] = votes[pred] + 1
        else:
            votes[pred] = 1

    best_label = None
    best_count = 0
    for label in votes:
        if votes[label] > best_count:
            best_count = votes[label]
            best_label = label

    return best_label

model_predictions = ["cat", "dog", "cat", "cat", "dog"]
final_prediction = majority_vote(model_predictions)
print("Final ensemble prediction:", final_prediction)
